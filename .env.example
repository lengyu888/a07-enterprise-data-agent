# Local-only database settings. Do not reuse these values outside development.
POSTGRES_DB=a07_agent
POSTGRES_USER=a07_app
POSTGRES_PASSWORD=a07_local_dev_change_me
POSTGRES_PORT=55432

# App ports
APP_PORT=8000
WEB_PORT=8080

# DeepSeek is optional during phase 0. The Docker stack reads the key from
# .secrets/deepseek_api_key via compose.deepseek.yml, not from this file.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
